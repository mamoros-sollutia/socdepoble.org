+const BLOQUEIGS = [];
+
+const ANCORA = process.env.SDP_ANCORA || 'tooling/brain/ancora.mjs';
+if (!existsSync(join(PROJECT_DIR, ANCORA))) {
+  BLOQUEIGS.push(
+    `L'àncora de sessió «${ANCORA}» no existix. Sense punt de retorn no s'obri sessió.\n`
+    + '     Escriu-la, o declara la ruta real a SDP_ANCORA.');
+} else {
+  try {
+    execSync(`node ${ANCORA} --pon "arranc de sessio"`, { cwd: PROJECT_DIR, stdio: 'inherit' });
+  } catch (e) {
+    BLOQUEIGS.push(`L'àncora existix però ha fallat: ${e.message}`);
+  }
+}

