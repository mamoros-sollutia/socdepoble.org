+/**
+ * Torna l'element que porta data-theme: l'amfitrio <soc-de-poble> quan estem
+ * dins del Shadow DOM, i nomes fora d'ell l'arrel del document.
+ * Ha de coincidir amb l'objectiu d'escriptura de App.jsx:73.
+ */
+export function arrelDelTema(node) {
+  if (typeof document === 'undefined') return null;
+  const arrel = node && typeof node.getRootNode === 'function' ? node.getRootNode() : null;
+  if (typeof ShadowRoot !== 'undefined' && arrel instanceof ShadowRoot) return arrel.host;
+  const marcat = document.querySelector('[data-theme]');
+  if (marcat) return marcat;
+  return document.querySelector('.sdp-root') || document.documentElement;
+}
