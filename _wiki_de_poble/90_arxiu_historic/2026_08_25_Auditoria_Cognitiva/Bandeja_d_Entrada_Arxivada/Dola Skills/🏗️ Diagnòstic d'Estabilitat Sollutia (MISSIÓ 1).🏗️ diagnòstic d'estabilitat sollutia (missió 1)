const MAX_MESSAGES_PER_THREAD = 500;
const appendChatMessages = (threadId, newMessages) => {
  const current = messagesByThread[threadId] || [];
  const merged = [...current, ...newMessages];
  if (merged.length > MAX_MESSAGES_PER_THREAD) {
    return merged.slice(-MAX_MESSAGES_PER_THREAD);
  }
  return merged;
};
