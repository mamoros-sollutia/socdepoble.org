#!/bin/sh
set -eu
# SDP-REFLEX-HOOK:v2:pre-commit

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

REFLEX="tooling/wiki/reflex_petorreta.mjs"
node "$REFLEX" \
  verify --staged --operation=git-commit
TREE="$(node "$REFLEX" pending-tree)"

TMP_ROOT="${TMPDIR:-/tmp}"
AUDIT_TMP="$(mktemp -d "$TMP_ROOT/sdp-precommit.XXXXXX")"
trap 'rm -rf "$AUDIT_TMP"' EXIT HUP INT TERM
AUDIT_TREE="$AUDIT_TMP/tree"
mkdir -m 700 "$AUDIT_TREE"

# L’auditoria s’executa sobre els bytes exactes de l’arbre que Git commitejarà,
# mai sobre el worktree (que pot contindre canvis no staged o ocultar un symlink).
node "$REFLEX" materialize-tree --destination="$AUDIT_TREE"
node "$AUDIT_TREE/tooling/wiki/pre-commit.mjs" \
  --dry-run --wiki="$AUDIT_TREE/_wiki_de_poble"

# 🧠 Reflex Nerviós: Sincronitza la identitat de les IAs al Graf abans del commit
node scripts/immunitari/mirall_identitat.mjs
git add _wiki_de_poble/00_SER_Brain_Identitat/00_AGENTS_I_SKILLS_MIRROR/ || true

# 🩸 Sistema Immunitari: Porter de pre-commit
node scripts/immunitari/plaquetes.mjs diagnostic --porta || {
  echo "🩸 Les Plaquetes bloquegen el commit: ferides noves al graf."
  exit 1
}
