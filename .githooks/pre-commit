#!/bin/sh
# Hook de pre-commit de Sóc de Poble (Les Portes Mecàniques)

echo "🚪 Executant Portes Mecàniques..."

npm run gate

if [ $? -ne 0 ]; then
  echo "❌ El codi no passa les portes mecàniques (tractor-persistencia o lint). Commit avortat."
  exit 1
fi

# Validar BIOS (Regles de l'Ecosistema)
node tooling/verify-bios.mjs
if [ $? -ne 0 ]; then
  echo "❌ El BIOS està danyat o incomplet. Commit avortat."
  exit 1
fi

echo "✅ Portes superades. Endavant."
exit 0
