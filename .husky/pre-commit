#!/usr/bin/env sh

echo "🔍 Executant hook de pre-commit de Pedra Seca..."

# 1. Protecció contra secrets
if git diff --cached -i | grep -E "(VITE_SUPABASE_ANON_KEY=|eyJhbGciOiJIUzI1NiI|password=)"; then
  echo "🚨 ATENCIÓ: Has intentat fer commit de secrets o JWTs hardcoded!"
  echo "La pujada ha estat avortada per seguretat."
  exit 1
fi

# 2. Executar tests si existeixen
npm test || true

# 3. Time Machine (Estela)
sh tooling/gates/estela.sh "pre-commit"

# 4. Pressupost destructiu
node tooling/gates/rossec.mjs

# 5. Tractors i guàrdies
node tooling/gates/tractor-manual.mjs || exit 1
node tooling/gates/tractor-consell.mjs || exit 1
node tooling/gates/tractor-registre.mjs || exit 1
node tooling/gates/tractor-doctrina.mjs || exit 1
node tooling/wiki/pre-commit.mjs || exit 1
